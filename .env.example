# Copy this file to .env.local for local development with `vercel dev`.
# In production, set this in Vercel: Project Settings → Environment Variables.
# Prefer DeepSeek for food photo recognition.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-vl2
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions

# Optional fallback if you still want to use Anthropic.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
